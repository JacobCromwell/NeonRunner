# Godot
.godot/
*.translation
export_presets.cfg.local
/build/
/exports/*
# Keeps Godot from importing what an export writes (exports/web/index.png), which would ship in the next export.
!/exports/.gdignore

# OS / editor
.DS_Store
Thumbs.db
*.tmp

# Local Godot location found by tools/godot.sh
.godot-path
.godot-path-windows

# T-SPEED: a local, disposable timing hint for tools/godot.sh test --jobs=N (tests/run_tests.gd)
/tests/.suite_times.json

# Agent worktrees (Claude Code)
.claude/worktrees/
