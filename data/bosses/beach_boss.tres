[resource]
script = ExtResource("1_script")
id = &"beach_boss"
display_name = "Mecha Guppy and Captain Cogs"
scene = "res://scenes/bosses/mecha_guppy.tscn"
notes = "GDD §10: Mecha Guppy, a building-sized mechanical shark, eats the level from below while Captain Cogs, a pirate in a flying ship, throws bombs down at you. Climb by anti-grav pads and tiki huts onto higher and higher tiki bar roofs: drop off a hut only in a lane that leads up. Lead Captain Cogs' bombs into the notch the shark has bitten out of each roof's end and dodge out before the edge: the bomb falls into its jaws, a hit (and now and then Captain Cogs misses into the chasm anyway); weapons do nothing. At the top, level with Captain Cogs: dodge the captain's cannonballs by switching lanes and jump the waves for a minute, until Mecha Guppy leaps up and eats the captain."
weapon_share_cap = 0.0
weapons_can_end_phase = false
phases = Array[ExtResource("2_phase")]([SubResource("phase_1"), SubResource("phase_2"), SubResource("phase_3")])
arena = SubResource("arena")
arena_laps = 1
tuning = ExtResource("4_tuning")
music = &"beach"
payout_credits = 500
defeat_score = 5000
two_star_seconds = 230.0
three_star_seconds = 177.0
time_bonus_seconds = 280.0
armor_rule = true
armor_delay_min = 15.0
armor_delay_max = 17.0
armor_pickups_per_phase = 1
armor_when_unprotected = true
