[resource]
script = ExtResource("1_script")
id = &"city_boss"
display_name = "Floating Head"
scene = "res://scenes/bosses/floating_head.tscn"
notes = "GDD §10: a giant ship whose back is a cybernetic propaganda face shouting over the city. It bombs the lanes where its searchlight lingers, then turns to face you: eye-laser sweeps, and cyborgs dropped from its mouth. Bait a laser into a marked tower to pin it, then stomp the red weak point on its head, once per phase: up the fallen tower, by a wall jump, then dropping from a ceiling. Armor pickups help in the last phase. Beaten, it crashes into the street ahead and you run through the wreck."
weapon_share_cap = 0.34
phases = Array[ExtResource("2_phase")]([SubResource("phase_1"), SubResource("phase_2"), SubResource("phase_3")])
arena = SubResource("arena")
arena_laps = 3
tuning = ExtResource("4_tuning")
two_star_seconds = 150.0
three_star_seconds = 110.0
armor_rule = true
armor_delay_min = 10.0
armor_delay_max = 15.0
armor_pickups_per_phase = 1
armor_when_unprotected = true
