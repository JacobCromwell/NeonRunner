[gd_resource type="Resource" script_class="BossDef" format=3]

[ext_resource type="Script" path="res://scripts/campaign/boss_def.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/campaign/boss_phase.gd" id="2_phase"]

[sub_resource type="Resource" id="phase_1"]
script = ExtResource("2_phase")
health_share = 1.0
hits = 1
pace = 1.0
checkpoint = false
intro_seconds = 2.0

[sub_resource type="Resource" id="phase_2"]
script = ExtResource("2_phase")
health_share = 1.0
hits = 1
pace = 1.15
checkpoint = false
intro_seconds = 2.0

[sub_resource type="Resource" id="phase_3"]
script = ExtResource("2_phase")
health_share = 1.0
hits = 1
pace = 1.3
checkpoint = false
intro_seconds = 2.0

[resource]
script = ExtResource("1_script")
id = &"city_boss"
display_name = "Floating Head"
notes = "Designed, not built yet (GDD §10): a giant ship whose back is a cybernetic propaganda face shouting over the city. It bombs the lanes where its searchlight lingers, then turns to face you: eye-laser sweeps, and cyborgs dropped from its mouth. Bait a laser into a marked tower to pin it, then stomp the red weak point on its head, once per phase: up the fallen tower, by a wall jump, then dropping from a ceiling. Armor pickups help in the last phase."
weapon_share_cap = 0.34
phases = Array[ExtResource("2_phase")]([SubResource("phase_1"), SubResource("phase_2"), SubResource("phase_3")])
armor_rule = true
armor_delay_min = 10.0
armor_delay_max = 15.0
armor_pickups_per_phase = 1
