[resource]
script = ExtResource("1_script")
id = &"gangland_boss"
display_name = "Sewer Swarm"
scene = "res://scenes/bosses/sewer_swarm.tscn"
notes = "GDD §10: a horde of screeches rising from the sewers around the Host, a person fused with machines. Clusters surge down the lanes, then strike from behind while the swarm climbs one wall at a time. Bait them into live fences and holes; then reach the Host's glowing implants by a ramp and a wall jump, and stomp them six times to set the person free."
weapon_share_cap = 0.34
phases = Array[ExtResource("2_phase")]([SubResource("phase_1"), SubResource("phase_2"), SubResource("phase_3")])
arena = SubResource("arena")
arena_laps = 3
tuning = ExtResource("4_tuning")
music = &"gangland"
two_star_seconds = 150.0
three_star_seconds = 115.0
armor_rule = true
armor_delay_min = 15.0
armor_delay_max = 17.0
armor_pickups_per_phase = 1
armor_when_unprotected = true
