[gd_resource type="Resource" script_class="BossDef" format=3]

[ext_resource type="Script" path="res://scripts/campaign/boss_def.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"gangland_boss"
display_name = "Sewer Swarm"
notes = "DESIGN-TBD: still being designed (GDD §10). A mutant horde rising from the sewers: it builds up on both sides and a mob attacks, and you fight it off while running as the horde shifts ahead of you and behind you. Only 4–5 swarm clusters are simulated, drawn so they look like hundreds of screech-like creatures. The heavy missile does bonus damage against it."
