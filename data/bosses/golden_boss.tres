[gd_resource type="Resource" script_class="BossDef" format=3]

[ext_resource type="Script" path="res://scripts/campaign/boss_def.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"golden_boss"
display_name = "The final villain"
notes = "DESIGN-TBD: the fight is still to be designed (GDD §10). The all-powerful controller of this world, propped up by the cult (GDD §1). Unlike the other bosses, the final fight has a checkpoint halfway, where the villain may change into a second stage, and it may run a little longer than the others."
