[resource]
script = ExtResource("1_script")
id = &"golden_boss"
display_name = "The Golden Convergence"
scene = "res://scenes/bosses/golden_convergence.tscn"
notes = "GDD §10: the final villain. A giant golden suit, a gaudy man-made relic with the calm golden face of the cult and a dull red tear, floats at the far end of the Grand Court, its burgundy cape billowing. Stage 1: dodge its Helidrone Strafe (take cover in a Flying Buttress's arch from the horizontal passes), its Fist Slams and its Missile Barrage, and hurl its squadron into the Refill Ship from an anti-grav pad, three times. Stage 2, from the fight's checkpoint halfway: The Magnate himself, burnt and roaring, hunts the runner from behind; bait his Pounce into a buttress and stomp the red ports on his spine."
weapon_share_cap = 0.17
weapons_can_end_phase = true
phases = Array[ExtResource("2_phase")]([SubResource("phase_1"), SubResource("phase_2"), SubResource("phase_3"), SubResource("phase_4"), SubResource("phase_5"), SubResource("phase_6")])
arena = SubResource("arena")
arena_laps = 2
tuning = ExtResource("4_tuning")
music = &"golden"
health = 600.0
payout_credits = 1000
defeat_score = 10000
two_star_seconds = 330.0
three_star_seconds = 260.0
time_bonus_seconds = 400.0
armor_rule = true
armor_delay_min = 22.0
armor_delay_max = 22.0
armor_pickups_per_phase = 1
armor_when_unprotected = true
