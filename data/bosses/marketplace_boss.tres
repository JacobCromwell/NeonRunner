[resource]
script = ExtResource("1_script")
id = &"marketplace_boss"
display_name = "The House"
preview_scene = "res://scenes/bosses/the_house.tscn"
notes = "Designed, being built (GDD §10): a slot machine the size of a building, rolling down the market street. Each spin of its reels announces the attacks: cherry bombs, a rolling electric fence, gold blocks slammed into the lanes. Run over the glowing 7 buttons while the reels spin to rig a jackpot, then stomp the coin hopper that bursts open on top."
weapon_share_cap = 0.34
phases = Array[ExtResource("2_phase")]([SubResource("phase_1"), SubResource("phase_2"), SubResource("phase_3")])
arena = SubResource("arena")
arena_laps = 2
tuning = ExtResource("4_tuning")
music = &"marketplace"
armor_rule = true
armor_delay_min = 15.0
armor_delay_max = 17.0
armor_pickups_per_phase = 1
armor_when_unprotected = true
