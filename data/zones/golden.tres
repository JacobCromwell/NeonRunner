[resource]
script = ExtResource("1_script")
id = &"golden"
display_name = "Golden Zone"
tagline = "Golden walkways over water, in the opulent city of the elite."
music = &"golden"
skin = ExtResource("skin")
levels = Array[ExtResource("2_levelscript")]([ExtResource("lvl_golden_1"), ExtResource("lvl_golden_2"), ExtResource("lvl_golden_3")])
intro = ExtResource("c_intro")
outro = ExtResource("c_outro")
boss = ExtResource("boss")
in_demo = false
placeholder = false
