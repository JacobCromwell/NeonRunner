[gd_resource type="Resource" script_class="ZoneDef" format=3]

[ext_resource type="Script" path="res://scripts/campaign/zone_def.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/core/level_config.gd" id="2_levelscript"]
[ext_resource type="Resource" path="res://data/levels/golden_1.tres" id="lvl_golden_1"]
[ext_resource type="Resource" path="res://data/levels/golden_2.tres" id="lvl_golden_2"]
[ext_resource type="Resource" path="res://data/levels/golden_3.tres" id="lvl_golden_3"]
[ext_resource type="Resource" path="res://data/skins/greybox_skin.tres" id="skin"]
[ext_resource type="Resource" path="res://data/cinematics/golden_intro.tres" id="c_intro"]
[ext_resource type="Resource" path="res://data/cinematics/golden_outro.tres" id="c_outro"]
