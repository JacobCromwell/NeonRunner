[ext_resource type="Resource" path="res://data/cinematics/terminal_outro.tres" id="c_outro"]

[resource]
script = ExtResource("1_script")
id = &"terminal"
display_name = "The Terminal"
tagline = "An abandoned subway under the city, choked with debris."
music = &"terminal"
skin_path = "res://data/skins/dead_zone_skin.tres"
