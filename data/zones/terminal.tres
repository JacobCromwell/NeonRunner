[ext_resource type="Script" path="res://scripts/core/level_config.gd" id="2_levelscript"]
[ext_resource type="Resource" path="res://data/levels/terminal_1.tres" id="lvl_terminal_1"]
[ext_resource type="Resource" path="res://data/levels/terminal_2.tres" id="lvl_terminal_2"]
