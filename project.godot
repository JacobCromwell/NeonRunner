; Engine configuration file.
; Pinned engine: Godot 4.7.2-stable (standard build, not .NET). Do not upgrade without approval.

config_version=5

[application]

config/name="Neon Runner"
config/description="Grey-box prototype (risk test R1: core movement)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

TouchInput="*res://scripts/input/touch_input.gd"
Music="*res://scripts/audio/music_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

