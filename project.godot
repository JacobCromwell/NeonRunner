[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="floor"
3d_physics/layer_2="hull"
3d_physics/layer_3="hazard"
3d_physics/layer_4="wall_blocker"
3d_physics/layer_5="trigger"
3d_physics/layer_6="player"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.02, 0.015, 0.05, 1)
