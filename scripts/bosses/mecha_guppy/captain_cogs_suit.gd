class_name CaptainCogsSuit
extends RefCounted
## Captain Cogs (GDD §10: "a new enemy, only in this fight ... a pirate mixed with a futuristic look, in a floating ship
## flying above the track, throwing bombs down at the runner"; task E5e-b2), on the shared HumanoidRig like the runner,
## the cyborgs and the volleyball player, generated by code (CLAUDE.md, Assets): a burly pirate in a long frock coat,
## a tricorn hat with a brass cog badge, a braided black beard, an eyepatch, and the "cogs": a clockwork brass arm on the
## left with cog joints, and a brass monocle-eye whose lens glows the Beach's blue (the skin's neon_blue: parts()).
## DESIGN-TBD (docs/OPEN_QUESTIONS.md item 787): the look. In the Beach's palette (GDD §5): a deep teal coat with brass
## buttons and gold trim, an ochre sash, black boots with brass buckles. Only the clockwork eye's lens glows, in the
## Beach's decorative blue (never a hazard colour); nothing on the captain is red or pink, so the captain never reads as
## a hazard: the danger is the bombs, warned by their red circles. (The owner hasn't given Captain Cogs a pronoun: none
## is used.)
##
## Rig convention (HumanoidPiece): metres at design scale, +y up, -z forward (where the captain faces), +x the captain's
## right. Limb pieces are authored for the right limb (the left gets a mirrored copy, unless placed on one side only).

const CACHE_KEY: String = "captain_cogs_v1"
## The captain's height as modelled (soles to the top of the hat): CaptainCogsShip fits it to its size.
const DESIGN_HEIGHT: float = 1.5

const SKIN := Color(0.62, 0.44, 0.33)
const SKIN_SHADE := Color(0.5, 0.34, 0.25)
const BEARD := Color(0.07, 0.06, 0.06)
const COAT := Color(0.09, 0.22, 0.27)
const COAT_SHADE := Color(0.06, 0.15, 0.19)
const TRIM := Color(0.86, 0.68, 0.32)
const BRASS := Color(0.8, 0.6, 0.29)
const BRASS_DARK := Color(0.52, 0.37, 0.16)
const STEEL := Color(0.36, 0.38, 0.42)
const SASH := Color(0.74, 0.55, 0.18)
const SHIRT := Color(0.86, 0.82, 0.72)
const TROUSERS := Color(0.16, 0.14, 0.13)
const BOOT := Color(0.06, 0.055, 0.055)
const HAT := Color(0.05, 0.05, 0.06)
const PATCH := Color(0.03, 0.03, 0.03)
## The clockwork eye's lens glows softly (HumanoidPiece.glow) in the skin's decorative blue (BeachSkin.neon_blue).
const LENS_GLOW: float = 1.2

const RIM_COLOR := Color(0.95, 0.85, 0.7)
const RIM_STRENGTH: float = 0.2
const RIM_POWER: float = 3.0
const GLOW_ALBEDO: float = 0.35
const GLOW_ENERGY: float = 2.6

const BOX := HumanoidPiece.Shape.BOX
const PRISM := HumanoidPiece.Shape.PRISM
const LATHE := HumanoidPiece.Shape.LATHE
const BAND := HumanoidPiece.Shape.BAND
const MIRRORED := HumanoidPiece.Placement.MIRRORED
const RIGHT := HumanoidPiece.Placement.RIGHT
const LEFT := HumanoidPiece.Placement.LEFT

const BODY_SHADER: Shader = preload("res://scripts/characters/humanoid_body.gdshader")

## The parts per lens colour (one per skin's neon_blue: in practice one).
static var _parts: Dictionary = {}
static var _material: ShaderMaterial


## The captain's parts with the clockwork eye's lens in `lens` (the arena skin's neon_blue: CaptainCogsShip).
static func parts(lens: Color) -> HumanoidParts:
	var key: String = lens.to_html(false)
	if not _parts.has(key):
		_parts[key] = _build_parts(lens)
	return _parts[key]


static func material() -> ShaderMaterial:
	if _material == null:
		_material = ShaderMaterial.new()
		_material.shader = BODY_SHADER
		_material.set_shader_parameter(&"rim_color", RIM_COLOR)
		_material.set_shader_parameter(&"rim_strength", RIM_STRENGTH)
		_material.set_shader_parameter(&"rim_power", RIM_POWER)
		_material.set_shader_parameter(&"glow_albedo", GLOW_ALBEDO)
		_material.set_shader_parameter(&"glow_energy", GLOW_ENERGY)
	return _material


static func _build_parts(lens: Color) -> HumanoidParts:
	var p := HumanoidParts.new()
	p.cache_key = "%s_%s" % [CACHE_KEY, lens.to_html(false)]
	p.design_size = Vector3(0.74, DESIGN_HEIGHT, 0.56)
	# Burly: broad in the shoulder and the chest, long in the arm.
	p.shoulder_offset = Vector3(0.2, 0.25, 0.0)
	p.upper_arm_length = 0.21
	p.forearm_length = 0.19
	var list: Array[HumanoidPiece] = []
	_coat(list)
	_head(list, lens)
	_arms(list)
	_legs(list)
	p.pieces = list
	return p


## The long frock coat over a pale shirt: its body on the chest, its skirt to the knees on the pelvis, gold trim down
## its front edges, brass buttons, the ochre sash at the waist with a brass cog buckle, and a cutlass hilt at the hip.
static func _coat(list: Array[HumanoidPiece]) -> void:
	_add(list, &"chest", BOX, Vector3(0.3, 0.2, 0.2), Vector3(0.0, 0.05, 0.0), COAT, 0.0,
		{"chamfer": 0.35, "top_scale": Vector2(1.18, 1.05)})
	_add(list, &"chest", BOX, Vector3(0.38, 0.16, 0.22), Vector3(0.0, 0.21, 0.0), COAT, 0.0,
		{"chamfer": 0.45, "top_scale": Vector2(0.9, 0.86)})
	# The shirt's open front and its collar.
	_add(list, &"chest", BOX, Vector3(0.08, 0.2, 0.01), Vector3(0.0, 0.17, -0.112), SHIRT, 0.0, {"top_scale": Vector2(1.6, 1.0)})
	for x: float in [-0.07, 0.07]:
		_add(list, &"chest", BOX, Vector3(0.012, 0.34, 0.012), Vector3(x, 0.12, -0.112), TRIM, 0.0, {"shine": 0.5})
		for k: int in 3:
			_add(list, &"chest", BOX, Vector3(0.022, 0.022, 0.012), Vector3(x * 1.35, 0.02 + 0.08 * float(k), -0.115), BRASS, 0.0,
				{"shine": 0.7})
	# Epaulettes: brass cogs on the shoulders.
	_add(list, &"chest", LATHE, Vector3(0.1, 0.0, 0.1), Vector3(0.19, 0.29, 0.0), BRASS, 0.0, {"side": MIRRORED, "sides": 8,
		"profile": PackedVector4Array([Vector4(-0.015, 1.0, 1.0, 0.0), Vector4(0.015, 1.0, 1.0, 0.0)]), "shine": 0.6})
	# The sash and its cog buckle.
	_add(list, &"pelvis", LATHE, Vector3(0.29, 0.0, 0.22), Vector3(0.0, 0.05, 0.0), SASH, 0.0,
		{"sides": 8, "profile": PackedVector4Array([Vector4(-0.035, 1.0, 1.0, 0.0), Vector4(0.035, 1.0, 1.0, 0.0)])})
	_add(list, &"pelvis", LATHE, Vector3(0.07, 0.0, 0.07), Vector3(0.0, 0.05, -0.115), BRASS, 0.0, {"sides": 8,
		"rotation_degrees": Vector3(90.0, 0.0, 0.0), "profile": PackedVector4Array([Vector4(-0.01, 1.0, 1.0, 0.0),
			Vector4(0.01, 1.0, 1.0, 0.0)]), "shine": 0.7})
	# The skirt to the knees, open at the front, its hem and front edges trimmed.
	_add(list, &"pelvis", BOX, Vector3(0.32, 0.36, 0.24), Vector3(0.0, -0.15, 0.015), COAT_SHADE, 0.0,
		{"top_scale": Vector2(0.92, 0.95), "chamfer": 0.2})
	_add(list, &"pelvis", BOX, Vector3(0.33, 0.025, 0.245), Vector3(0.0, -0.33, 0.015), TRIM)
	# The cutlass's hilt and scabbard at the left hip.
	# (A centre segment's LEFT piece is the mirrored copy: authored on the right, +x.)
	_add(list, &"pelvis", BOX, Vector3(0.025, 0.36, 0.05), Vector3(0.17, -0.12, 0.06), BRASS_DARK, 0.0,
		{"side": LEFT, "rotation_degrees": Vector3(-18.0, 0.0, -6.0)})
	_add(list, &"pelvis", BOX, Vector3(0.06, 0.03, 0.03), Vector3(0.17, 0.08, 0.0), BRASS, 0.0, {"side": LEFT, "shine": 0.6})


## The head: a weathered face, the braided black beard, an eyepatch over the right eye and the clockwork monocle-eye on
## the left (a brass ring round a softly glowing lens in `lens`), the tricorn hat with its gold trim and brass cog badge.
static func _head(list: Array[HumanoidPiece], lens: Color) -> void:
	_add(list, &"neck", PRISM, Vector3(0.09, 0.07, 0.085), Vector3(0.0, 0.03, 0.0), SKIN)
	_add(list, &"head", LATHE, Vector3(0.17, 0.0, 0.18), Vector3.ZERO, SKIN, 0.0, {"sides": 8,
		"profile": PackedVector4Array([Vector4(-0.03, 0.66, 0.62, -0.012), Vector4(0.02, 0.92, 0.9, -0.004),
			Vector4(0.1, 1.0, 1.0, 0.0), Vector4(0.15, 0.82, 0.86, 0.006)])})
	# The beard: a full jaw and two braids hanging from the chin.
	_add(list, &"head", BOX, Vector3(0.17, 0.09, 0.07), Vector3(0.0, 0.02, -0.07), BEARD, 0.0,
		{"chamfer": 0.35, "top_scale": Vector2(1.05, 0.9)})
	for x: float in [-0.035, 0.035]:
		_add(list, &"head", PRISM, Vector3(0.035, 0.12, 0.035), Vector3(x, -0.06, -0.09), BEARD, 0.0, {"sides": 5,
			"top_scale": Vector2(1.2, 1.2)})
		_add(list, &"head", BOX, Vector3(0.04, 0.018, 0.04), Vector3(x, -0.115, -0.09), BRASS, 0.0, {"shine": 0.6})
	_add(list, &"head", BOX, Vector3(0.12, 0.016, 0.02), Vector3(0.0, 0.055, -0.088), BEARD)
	# The nose.
	_add(list, &"head", BOX, Vector3(0.028, 0.045, 0.03), Vector3(0.0, 0.07, -0.095), SKIN_SHADE, 0.0,
		{"top_scale": Vector2(0.65, 0.45)})
	# The eyepatch (the right eye's) and its strap.
	_add(list, &"head", BOX, Vector3(0.045, 0.04, 0.012), Vector3(0.042, 0.1, -0.088), PATCH, 0.0, {"side": RIGHT})
	_add(list, &"head", BOX, Vector3(0.19, 0.008, 0.19), Vector3(0.0, 0.118, 0.0), PATCH, 0.0, {"rotation_degrees": Vector3(0.0, 0.0, -14.0)})
	# The clockwork eye (the left): a brass ring and the glowing lens.
	_add(list, &"head", LATHE, Vector3(0.05, 0.0, 0.05), Vector3(0.042, 0.1, -0.09), BRASS, 0.0, {"side": LEFT, "sides": 8,
		"rotation_degrees": Vector3(90.0, 0.0, 0.0), "profile": PackedVector4Array([Vector4(-0.012, 1.0, 1.0, 0.0),
			Vector4(0.012, 1.0, 1.0, 0.0)]), "shine": 0.7})
	_add(list, &"head", BOX, Vector3(0.03, 0.03, 0.01), Vector3(0.042, 0.1, -0.1), lens, LENS_GLOW, {"side": LEFT})
	# The tricorn: a crown, the brim turned up into three points, the gold trim and the brass cog badge at its front.
	_add(list, &"head", PRISM, Vector3(0.17, 0.08, 0.17), Vector3(0.0, 0.2, 0.0), HAT, 0.0, {"sides": 8,
		"top_scale": Vector2(0.8, 0.8)})
	_add(list, &"head", PRISM, Vector3(0.36, 0.03, 0.36), Vector3(0.0, 0.17, 0.0), HAT, 0.0, {"sides": 3,
		"section_phase": 30.0, "top_scale": Vector2(0.92, 0.92)})
	_add(list, &"head", PRISM, Vector3(0.37, 0.012, 0.37), Vector3(0.0, 0.19, 0.0), TRIM, 0.0, {"sides": 3,
		"section_phase": 30.0, "top_scale": Vector2(0.97, 0.97)})
	_add(list, &"head", LATHE, Vector3(0.06, 0.0, 0.06), Vector3(0.0, 0.215, -0.085), BRASS, 0.0, {"sides": 8,
		"rotation_degrees": Vector3(90.0, 0.0, 0.0), "profile": PackedVector4Array([Vector4(-0.008, 1.0, 1.0, 0.0),
			Vector4(0.008, 1.0, 1.0, 0.0)]), "shine": 0.7})


## The arms: the coat's sleeves with their wide cuffs and the right hand; on the left the clockwork arm, brass and steel
## with cog joints at the shoulder, elbow and wrist, and its pincer hand.
static func _arms(list: Array[HumanoidPiece]) -> void:
	_add(list, &"upper_arm", PRISM, Vector3(0.11, 0.21, 0.11), Vector3(0.0, -0.1, 0.0), COAT, 0.0,
		{"side": RIGHT, "top_scale": Vector2(1.15, 1.15)})
	_add(list, &"forearm", PRISM, Vector3(0.09, 0.15, 0.09), Vector3(0.0, -0.07, 0.0), COAT, 0.0, {"side": RIGHT})
	_add(list, &"forearm", LATHE, Vector3(0.12, 0.0, 0.12), Vector3(0.0, -0.15, 0.0), TRIM, 0.0, {"side": RIGHT, "sides": 6,
		"profile": PackedVector4Array([Vector4(-0.025, 1.0, 1.0, 0.0), Vector4(0.025, 1.05, 1.05, 0.0)])})
	_add(list, &"hand", BOX, Vector3(0.065, 0.075, 0.075), Vector3(0.0, -0.04, -0.004), SKIN, 0.0, {"side": RIGHT, "chamfer": 0.35})
	# The clockwork arm.
	_add(list, &"upper_arm", LATHE, Vector3(0.12, 0.0, 0.12), Vector3(0.0, 0.0, 0.0), BRASS, 0.0, {"side": LEFT, "sides": 8,
		"rotation_degrees": Vector3(0.0, 0.0, 90.0), "profile": PackedVector4Array([Vector4(-0.025, 1.0, 1.0, 0.0),
			Vector4(0.025, 1.0, 1.0, 0.0)]), "shine": 0.7})
	_add(list, &"upper_arm", PRISM, Vector3(0.06, 0.2, 0.06), Vector3(0.0, -0.11, 0.0), STEEL, 0.0, {"side": LEFT, "sides": 6,
		"shine": 0.6})
	_add(list, &"forearm", LATHE, Vector3(0.1, 0.0, 0.1), Vector3(0.0, 0.0, 0.0), BRASS, 0.0, {"side": LEFT, "sides": 8,
		"rotation_degrees": Vector3(0.0, 0.0, 90.0), "profile": PackedVector4Array([Vector4(-0.02, 1.0, 1.0, 0.0),
			Vector4(0.02, 1.0, 1.0, 0.0)]), "shine": 0.7})
	_add(list, &"forearm", PRISM, Vector3(0.07, 0.17, 0.07), Vector3(0.0, -0.09, 0.0), BRASS_DARK, 0.0, {"side": LEFT, "sides": 6,
		"shine": 0.5})
	_add(list, &"hand", BOX, Vector3(0.02, 0.08, 0.04), Vector3(0.025, -0.04, 0.0), STEEL, 0.0, {"side": LEFT, "shine": 0.6})
	_add(list, &"hand", BOX, Vector3(0.02, 0.08, 0.04), Vector3(-0.025, -0.04, 0.0), STEEL, 0.0, {"side": LEFT, "shine": 0.6})


## Dark trousers into tall black boots with brass buckles.
static func _legs(list: Array[HumanoidPiece]) -> void:
	_add(list, &"thigh", PRISM, Vector3(0.13, 0.3, 0.13), Vector3(0.0, -0.14, 0.0), TROUSERS, 0.0, {"top_scale": Vector2(1.1, 1.1)})
	_add(list, &"shin", PRISM, Vector3(0.11, 0.28, 0.115), Vector3(0.0, -0.13, 0.0), BOOT, 0.0, {"top_scale": Vector2(1.25, 1.2)})
	_add(list, &"shin", BOX, Vector3(0.12, 0.025, 0.125), Vector3(0.0, -0.05, 0.0), BRASS, 0.0, {"shine": 0.6})
	_add(list, &"foot", BOX, Vector3(0.095, 0.06, 0.2), Vector3(0.0, -0.04, -0.045), BOOT, 0.0,
		{"chamfer": 0.3, "top_scale": Vector2(0.85, 0.7), "top_shift": 0.02})


static func _add(list: Array[HumanoidPiece], segment: StringName, shape: HumanoidPiece.Shape, size: Vector3,
		at: Vector3, color: Color, glow: float = 0.0, extra: Dictionary = {}) -> void:
	var piece := HumanoidPiece.new()
	piece.segment = segment
	piece.shape = shape
	piece.size = size
	piece.offset = at
	piece.color = color
	piece.glow = glow
	for key: String in extra:
		piece.set(key, extra[key])
	list.append(piece)
