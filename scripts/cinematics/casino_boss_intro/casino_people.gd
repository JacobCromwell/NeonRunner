## The cocktail glass in her left hand: a stem and a bowl of pale blue-grey glass with a shine (nothing glows). It
## stands out of the front of the fist (the hand's -z), upright when the forearm is held level (CasinoPerson.hold_glass).
static func _cocktail_glass(list: Array[HumanoidPiece]) -> void:
	var up := Vector3(-90.0, 0.0, 0.0)
	var at := Vector3(0.0, -0.045, -0.03)
	_add(list, &"hand", PRISM, Vector3(0.036, 0.007, 0.036), Vector3(0.0, -0.045, 0.034), GLASS,
		{"sides": 8, "rotation_degrees": up, "side": LEFT, "shine": 0.9})
	_add(list, &"hand", PRISM, Vector3(0.008, 0.07, 0.008), at, GLASS,
		{"sides": 6, "rotation_degrees": up, "side": LEFT, "shine": 0.9})
	_add(list, &"hand", PRISM, Vector3(0.016, 0.05, 0.016), Vector3(0.0, -0.045, -0.086), GLASS,
