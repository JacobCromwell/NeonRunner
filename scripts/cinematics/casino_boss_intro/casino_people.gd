	# The gown's bodice, its neckline in gold, its waist band, and the hips under the skirt.
	_add(list, &"chest", BOX, Vector3(0.2, 0.16, 0.14), Vector3(0.0, 0.05, 0.002), gown,
		{"chamfer": 0.35, "top_scale": Vector2(1.1, 1.06)})
	_add(list, &"chest", BOX, Vector3(0.225, 0.13, 0.155), Vector3(0.0, 0.19, 0.0), gown,
		{"chamfer": 0.4, "top_scale": Vector2(1.08, 0.86)})
	_add(list, &"chest", BOX, Vector3(0.1, 0.085, 0.01), Vector3(0.0, 0.205, -0.0725), LADY_SKIN,
		{"top_scale": Vector2(1.3, 1.0)})
	_add(list, &"chest", BOX, Vector3(0.012, 0.1, 0.008), Vector3(0.039, 0.206, -0.0765), GOLD,
		{"side": MIRRORED, "rotation_degrees": Vector3(0.0, 0.0, -29.0), "shine": GOLD_SHINE})
	_add(list, &"chest", BOX, Vector3(0.012, 0.13, 0.006), Vector3(0.0, 0.07, -0.0725), GOLD, {"shine": GOLD_SHINE})
	_add(list, &"chest", BOX, Vector3(0.215, 0.032, 0.15), Vector3(0.0, -0.008, 0.0), GOLD,
		{"chamfer": 0.35, "shine": GOLD_SHINE})
	_add(list, &"pelvis", BOX, Vector3(0.27, 0.14, 0.2), Vector3(0.0, 0.03, 0.0), gown, {"chamfer": 0.3})
	_add(list, &"neck", PRISM, Vector3(0.066, 0.075, 0.066), Vector3(0.0, 0.02, 0.0), LADY_SKIN, {"sides": 8})
	_woman_face(list, hair, look)
	# Her arms: bare upper arms, red armoured pauldrons edged in gold, gold cybernetic forearms and hands.
	_add(list, &"upper_arm", PRISM, Vector3(0.066, 0.19, 0.064), Vector3(0.0, -0.1, 0.0), LADY_SKIN,
		{"sides": 8, "top_scale": Vector2(1.1, 1.1)})
	_add(list, &"upper_arm", BOX, Vector3(0.15, 0.012, 0.16), Vector3(0.018, 0.012, 0.0), GOLD,
		{"chamfer": 0.3, "shine": GOLD_SHINE})
	_add(list, &"upper_arm", BOX, Vector3(0.14, 0.04, 0.15), Vector3(0.018, 0.038, 0.0), gown,
		{"chamfer": 0.3, "top_scale": Vector2(0.8, 0.85), "shine": 0.3})
	_add(list, &"upper_arm", BOX, Vector3(0.1, 0.034, 0.11), Vector3(0.022, 0.07, 0.0), gown,
		{"chamfer": 0.3, "top_scale": Vector2(0.72, 0.78), "shine": 0.3})
	_add(list, &"upper_arm", BOX, Vector3(0.012, 0.018, 0.12), Vector3(0.083, 0.045, 0.0), GOLD, {"shine": GOLD_SHINE})
	_add(list, &"upper_arm", PRISM, Vector3(0.07, 0.014, 0.068), Vector3(0.0, -0.188, 0.0), GOLD_DARK, {"sides": 8})
