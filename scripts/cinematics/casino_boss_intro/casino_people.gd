## Lady Luck's skirt (four panels): a long brown layer to mid-shin and a shorter dusty-tan layer over it, the hems
## ragged (a few tattered points), tan the front.
static func _luck_panels() -> Array[HumanoidPanel]:
	var long_sk := Skirt.new(LUCK_HALF, LUCK_HINGE_Y, 0.46, [Vector3(0.14, 1.1, 1.1), Vector3(0.46, 1.5, 1.55)])
	var short_sk := Skirt.new(LUCK_HALF + Vector2(0.008, 0.008), LUCK_HINGE_Y, 0.3, [Vector3(0.1, 1.08, 1.08),
		Vector3(0.3, 1.38, 1.42)])
	var out: Array[HumanoidPanel] = []
	for side: int in [1, -1]:
		for behind: bool in [false, true]:
			var panel: HumanoidPanel = long_sk.panel(side, behind, 0.5 if behind else 0.6)
			var arc := Vector2(90.0, 180.0) if behind else Vector2(0.0, 90.0)
			panel.pieces.append(long_sk.shell(arc, SKIRT_BROWN))
			panel.pieces.append(long_sk.band(arc, BRONZE_DARK, 0.4, 0.46, 0.004))
			panel.pieces.append(short_sk.shell(arc, SKIRT_TAN))
			panel.pieces.append(short_sk.band(arc, ROSE_BROWN_DARK, 0.26, 0.3, 0.004))
			# The ragged hems: points hanging off both layers.
			var angles: Array[float] = [20.0, 50.0, 80.0]
			if behind:
				angles = [100.0, 130.0, 160.0]
			for angle: float in angles:
				panel.pieces.append(long_sk.tatter(angle, 0.46, 0.07, 0.05, SKIRT_BROWN))
				panel.pieces.append(short_sk.tatter(angle + 12.0, 0.3, 0.06, 0.045, SKIRT_TAN))
			out.append(panel)
	return out


