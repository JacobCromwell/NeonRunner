## The skirt of the gown (four panels): a flaring gown to the floor, two gold stripes on each front panel and a gold
## hem. Each follows the thigh on its side like the runner's coat.
static func _gown_panels(gown: Color, shade: Color) -> Array[HumanoidPanel]:
	var sk := Skirt.new(GOWN_HALF, GOWN_HINGE_Y, GOWN_LENGTH, [Vector3(0.12, 1.06, 1.06), Vector3(0.28, 1.2, 1.2),
		Vector3(0.45, 1.5, 1.55), Vector3(GOWN_LENGTH, 1.95, 2.0)])
	var out: Array[HumanoidPanel] = []
	for side: int in [1, -1]:
		for behind: bool in [false, true]:
			var panel: HumanoidPanel = sk.panel(side, behind, 0.3 if behind else 0.35)
			var arc := Vector2(90.0, 180.0) if behind else Vector2(0.0, 90.0)
			panel.pieces.append(sk.shell(arc, gown))
			# A darker flounce at the hem, a gold edge on it.
			panel.pieces.append(sk.band(arc, shade, GOWN_LENGTH * 0.72, GOWN_LENGTH, 0.004))
			panel.pieces.append(sk.band(arc, GOLD, GOWN_LENGTH - 0.03, GOWN_LENGTH, 0.008, GOLD_SHINE))
			if not behind:
				for angle: float in [15.0, 75.0]:
					panel.pieces.append(sk.stripe(angle, 0.1, GOWN_LENGTH - 0.05, 0.014, GOLD))
			out.append(panel)
	return out


## Her face, the women's shared build: the same face, a different hairstyle.
