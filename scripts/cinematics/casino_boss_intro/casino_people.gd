## The coat's skirt, below the knees: four panels hinged under the belt, the front ones the two edges of the open
## coat (a lighter edge down them), the back ones split by the vent; a lighter hem on each.
static func _coat_panels() -> Array[HumanoidPanel]:
	var sk := Skirt.new(COAT_HALF, COAT_HINGE_Y, COAT_LENGTH, [Vector3(0.2, 1.1, 1.1), Vector3(COAT_LENGTH, 1.32, 1.32)])
	var out: Array[HumanoidPanel] = []
	for side: int in [1, -1]:
		for behind: bool in [false, true]:
			var panel: HumanoidPanel = sk.panel(side, behind, 0.5 if behind else 0.6)
			var arc := Vector2(91.0, 179.0) if behind else Vector2(31.0, 89.0)
			panel.pieces.append(sk.shell(arc, COAT))
			panel.pieces.append(sk.band(arc, COAT_EDGE, COAT_LENGTH - 0.05, COAT_LENGTH, 0.005))
			if not behind:
				panel.pieces.append(sk.stripe(30.0, 0.0, COAT_LENGTH - 0.02, 0.016, COAT_EDGE, 0.0, false))
			out.append(panel)
	return out


# --- Shared pieces --------------------------------------------------------------------------------------------------

## The parts' frame: the skeleton `s` (keys hip, thigh, shin, neck, shoulder, upper, fore, chest; others stay at the
## rig's defaults) and the box the look is modelled to fill. Every look has its own cache key.
static func _frame(look: Look, size: Vector3, s: Dictionary) -> HumanoidParts:
	var p := HumanoidParts.new()
	p.cache_key = "casino_people_%s_%s" % [CACHE_VERSION, look_name(look).to_lower()]
	p.design_size = size
	p.hip_offset = s.get("hip", p.hip_offset)
	p.thigh_length = s.get("thigh", p.thigh_length)
	p.shin_length = s.get("shin", p.shin_length)
	p.chest_offset = s.get("chest", p.chest_offset)
	p.neck_offset = s.get("neck", p.neck_offset)
	p.shoulder_offset = s.get("shoulder", p.shoulder_offset)
	p.upper_arm_length = s.get("upper", p.upper_arm_length)
	p.forearm_length = s.get("fore", p.forearm_length)
	return p


## A plain face on the head joint (the neck is each look's own): a chamfered head, a nose, two dark eyes (`covered` -1 / 1 leaves the left / right
## one out, for an eyepiece), two brows (`slant` degrees: + stern, - kind) and a mouth line. Options: w, h, d (the head's
## box), brow (colour), lips (colour), lashes (a dark line over each eye), chamfer, neck (a neck prism's width; 0 none).
static func _face(list: Array[HumanoidPiece], skin: Color, shade: Color, o: Dictionary = {}) -> void:
	var w: float = o.get("w", 0.15)
	var h: float = o.get("h", 0.17)
	var d: float = o.get("d", 0.15)
	var cy: float = h * 0.5 - 0.01
	var top := Vector2(0.92, 0.94)
	var brow: Color = o.get("brow", CHAIRMAN_HAIR)
	var covered: int = o.get("covered", 0)
	_add(list, &"head", BOX, Vector3(w, h, d), Vector3(0.0, cy, 0.0), skin,
		{"chamfer": o.get("chamfer", 0.4), "top_scale": top})
	var eye_y: float = cy + h * 0.1
	var eye_x: float = w * 0.235
	_add(list, &"head", BOX, Vector3(w * 0.16, h * 0.2, d * 0.13), Vector3(0.0, cy - h * 0.06, _front(cy - h * 0.06, cy, h, d, top.y) - 0.007),
		shade, {"top_scale": Vector2(0.7, 0.5)})
	for side: int in [1, -1]:
		if side != covered:
			_add(list, &"head", BOX, Vector3(w * 0.16, h * 0.09, 0.006), Vector3(side * eye_x, eye_y, _front(eye_y, cy, h, d, top.y)),
				EYES)
			if o.get("lashes", false):
				_add(list, &"head", BOX, Vector3(w * 0.2, h * 0.03, 0.006), Vector3(side * eye_x, eye_y + h * 0.065,
					_front(eye_y, cy, h, d, top.y)), brow)
	var brow_y: float = eye_y + h * 0.14
	_add(list, &"head", BOX, Vector3(w * 0.24, h * 0.045, 0.006), Vector3(eye_x, brow_y, _front(brow_y, cy, h, d, top.y)), brow,
		{"side": MIRRORED, "rotation_degrees": Vector3(0.0, 0.0, o.get("slant", 0.0))})
	var mouth_y: float = cy - h * 0.28
	_add(list, &"head", BOX, Vector3(w * 0.24, h * 0.045, 0.006), Vector3(0.0, mouth_y, _front(mouth_y, cy, h, d, top.y)),
		o.get("lips", MOUTH))


## The z of a head's front face at height `y` (the head box centred at `cy`, `h` tall and `d` deep, its top end scaled
## `top_z` in depth: the face tapers toward the top).
static func _front(y: float, cy: float, h: float, d: float, top_z: float) -> float:
	return -(d * 0.5) * (1.0 - (1.0 - top_z) * clampf((y - (cy - h * 0.5)) / h, 0.0, 1.0))


## A piece; `extra` sets any other HumanoidPiece property by name (side, chamfer, glow, shine, ...).
static func _piece(segment: StringName, shape: HumanoidPiece.Shape, size: Vector3, at: Vector3, color: Color,
		extra: Dictionary = {}) -> HumanoidPiece:
	var piece := HumanoidPiece.new()
	piece.segment = segment
	piece.shape = shape
	piece.size = size
	piece.offset = at
	piece.color = color
	for key: String in extra:
		piece.set(key, extra[key])
	return piece


static func _add(list: Array[HumanoidPiece], segment: StringName, shape: HumanoidPiece.Shape, size: Vector3,
		at: Vector3, color: Color, extra: Dictionary = {}) -> void:
	list.append(_piece(segment, shape, size, at, color, extra))


## A thin flat box from `a` to `b` with its flat face toward `face` (a stripe of trim on a skirt).
static func _strip(segment: StringName, a: Vector3, b: Vector3, width: float, depth: float, face: Vector3, color: Color,
		extra: Dictionary = {}) -> HumanoidPiece:
	var along: Vector3 = b - a
	var y: Vector3 = along.normalized()
	var z: Vector3 = (face - y * face.dot(y)).normalized()
	var basis := Basis(y.cross(z), y, z)
	var more: Dictionary = {"rotation_degrees": basis.get_euler() * (180.0 / PI)}
	more.merge(extra)
	return _piece(segment, BOX, Vector3(width, along.length(), depth), (a + b) * 0.5, color, more)


## A skirt: the waist ring its panels hang from (a 12-sided ring in the pelvis joint's space, corners at every 30°
## from the front), how it flares toward the hem, and what is built on it. Its rings are (depth below the hinge, x scale,
## z scale); the first one is the hinge's own ring (scale 1).
class Skirt extends RefCounted:
	var half: Vector2
	var hinge_y: float
	var length: float
	var rings: Array[Vector3] = []

	func _init(p_half: Vector2, p_hinge_y: float, p_length: float, p_rings: Array) -> void:
		half = p_half
		hinge_y = p_hinge_y
		length = p_length
		rings.append(Vector3(0.0, 1.0, 1.0))
		for r: Vector3 in p_rings:
			rings.append(r)

	## The ring's x and z scale at `depth` below the hinge.
	func scale_at(depth: float) -> Vector2:
		for i: int in range(1, rings.size()):
			if depth <= rings[i].x or i == rings.size() - 1:
				var a: Vector3 = rings[i - 1]
				var b: Vector3 = rings[i]
				var u: float = clampf((depth - a.x) / maxf(b.x - a.x, 0.0001), 0.0, 1.0)
				return Vector2(lerpf(a.y, b.y, u), lerpf(a.z, b.z, u))
		return Vector2.ONE

	## A panel on `side` (1 right, -1 left): in front of the leg or behind it, hung from a hinge halfway through its depth.
	func panel(side: int, behind: bool, follow: float) -> HumanoidPanel:
		var out := HumanoidPanel.new()
		out.side = side
		out.behind = behind
		out.length = length
		out.hinge = Vector3(half.x * 0.62, hinge_y, half.y * (0.46 if behind else -0.46) + 0.005)
		out.follow = follow
		return out

	## The sheet of the panel over `arc` (degrees, 0 front, 90 the right side, 180 the back).
	func shell(arc: Vector2, color: Color) -> HumanoidPiece:
		var profile := PackedVector4Array([Vector4(0.03, 1.0, 1.0, 0.0)])
		for r: Vector3 in rings:
			if r.x > 0.0:
				profile.append(Vector4(-r.x, r.y, r.z, 0.0))
		return CasinoPeople._piece(&"pelvis", SHELL, Vector3(half.x * 2.0, 0.0, half.y * 2.0),
			Vector3(0.0, hinge_y, 0.005), color, {"sides": 12, "section_phase": 15.0, "arc": arc, "thickness": 0.012,
				"profile": profile})

	## A band of trim over `arc` from `from_depth` to `to_depth` below the hinge, `out` metres outside the sheet.
	func band(arc: Vector2, color: Color, from_depth: float, to_depth: float, out: float, shine: float = 0.0) -> HumanoidPiece:
		var profile := PackedVector4Array()
		for depth: float in [from_depth, to_depth]:
			var s: Vector2 = scale_at(depth)
			profile.append(Vector4(-depth, s.x + out / half.x, s.y + out / half.y, 0.0))
		return CasinoPeople._piece(&"pelvis", BAND, Vector3(half.x * 2.0, 0.0, half.y * 2.0),
			Vector3(0.0, hinge_y, 0.005), color, {"sides": 12, "section_phase": 15.0, "arc": arc, "profile": profile,
				"shine": shine})

	## A point on the skirt's outside at `angle` degrees round it (0 front, 90 right side, 180 back) and `depth` below
	## the hinge; `face`: on the middle of a face (the faces' centres are at 15°, 45°, ...), not on a corner.
	func point(angle: float, depth: float, out: float = 0.0, face: bool = true) -> Vector3:
		var s: Vector2 = scale_at(depth)
		var a: float = deg_to_rad(angle)
		var k: float = 0.966 if face else 1.0
		var n := Vector3(sin(a), 0.0, -cos(a))
		return Vector3(sin(a) * half.x * s.x * k, hinge_y - depth, -cos(a) * half.y * s.y * k + 0.005) + n * out

	## A stripe of trim down the skirt at `angle` from `from_depth` to `to_depth`.
	func stripe(angle: float, from_depth: float, to_depth: float, width: float, color: Color, out: float = 0.004,
			face: bool = true) -> HumanoidPiece:
		var a: Vector3 = point(angle, from_depth, out, face)
		var b: Vector3 = point(angle, to_depth, out, face)
		var n := Vector3(sin(deg_to_rad(angle)), 0.0, -cos(deg_to_rad(angle)))
		return CasinoPeople._strip(&"pelvis", a, b, width, 0.008, n, color, {"shine": 0.7 if color == GOLD else 0.0})

	## A ragged point hanging off the hem at `angle`: a small downward triangle, `tall` long, `wide` wide.
	func tatter(angle: float, depth: float, tall: float, wide: float, color: Color) -> HumanoidPiece:
		var at: Vector3 = point(angle, depth - tall * 0.35, 0.0)
		return CasinoPeople._piece(&"pelvis", BOX, Vector3(wide, tall, 0.012), at, color,
			{"top_scale": Vector2(0.0, 1.0), "rotation_degrees": Vector3(0.0, 180.0 - angle, 180.0)})
