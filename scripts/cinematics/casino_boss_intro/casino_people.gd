	# The hair every style shares: a cap and the back of the head.
	_add(list, &"head", BOX, Vector3(0.158, 0.07, 0.158), Vector3(0.0, 0.138, 0.006), hair,
		{"chamfer": 0.4, "top_scale": Vector2(0.88, 0.86)})
	_add(list, &"head", BOX, Vector3(0.152, 0.1, 0.04), Vector3(0.0, 0.1, 0.062), hair, {"chamfer": 0.3})
	match look:
		Look.LADY_IN_RED:
			# Dark hair up in a bun, a few strands at her temples, and a thin gold circlet with a small red stone.
			_add(list, &"head", PRISM, Vector3(0.09, 0.056, 0.09), Vector3(0.0, 0.19, 0.056), hair,
				{"sides": 8, "top_scale": Vector2(0.85, 0.85), "rotation_degrees": Vector3(20.0, 0.0, 0.0)})
			_add(list, &"head", BOX, Vector3(0.012, 0.07, 0.014), Vector3(0.072, 0.085, -0.045), hair,
				{"side": MIRRORED, "rotation_degrees": Vector3(0.0, 0.0, 6.0)})
			_add(list, &"head", BOX, Vector3(0.164, 0.014, 0.164), Vector3(0.0, 0.118, 0.004), GOLD,
				{"chamfer": 0.4, "shine": GOLD_SHINE})
			_add(list, &"head", PRISM, Vector3(0.026, 0.034, 0.012), Vector3(0.0, 0.14, -0.083), GOLD,
				{"sides": 4, "top_scale": Vector2(0.2, 0.5), "shine": GOLD_SHINE})
			_add(list, &"head", BOX, Vector3(0.012, 0.016, 0.008), Vector3(0.0, 0.119, -0.085), CRIMSON_SHADE,
				{"shine": 0.8})
		Look.ESCORT_BLACK:
			# Long straight black hair: a curtain either side of her face, the rest down her back to the waist.
			_add(list, &"head", BOX, Vector3(0.016, 0.13, 0.12), Vector3(0.078, 0.06, 0.01), hair,
				{"side": MIRRORED})
			_add(list, &"head", BOX, Vector3(0.152, 0.17, 0.03), Vector3(0.0, 0.04, 0.085), hair, {"chamfer": 0.2})
