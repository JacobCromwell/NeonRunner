static var _parts: Dictionary = {}
static var _heights: Dictionary = {}


## The look's parts (built once; every person of that look shares them).
static func parts(look: Look) -> HumanoidParts:
	if not _parts.has(look):
		_parts[look] = _build(look)
	return _parts[look]


## The look's height as modelled (feet to the top of the head or the hair).
static func design_height(look: Look) -> float:
	if not _heights.has(look):
		var p: HumanoidParts = parts(look)
		var top: float = 0.0
		var head: ArrayMesh = p.segment_mesh(&"head", 0)
		if head != null:
			for v: Vector3 in head.get_meta(&"points"):
				top = maxf(top, v.y)
		_heights[look] = p.pelvis_height() + p.chest_offset.y + p.neck_offset.y + p.head_offset.y + top
	return _heights[look]


## True when the look has panels (a skirt or a coat the rig swings): its person needs its own copy of the material.
static func has_panels(look: Look) -> bool:
	return look == Look.LADY_IN_RED or look == Look.ESCORT_BLACK or look == Look.ESCORT_BLONDE \
		or look == Look.LADY_LUCK or look == Look.CHAIRMAN


## True when the look carries a cocktail glass in her left hand (hold_glass keeps it upright).
static func has_glass(look: Look) -> bool:
	return look == Look.LADY_IN_RED


## How long a walking step the look takes, a share of the walk's full stride (CinePoses): the long gowns take short steps
## (a skirt panel swings with the leg it hangs from, and a long stride would throw the hem out behind her).
static func stride_scale(look: Look) -> float:
	match look:
		Look.LADY_IN_RED, Look.ESCORT_BLACK, Look.ESCORT_BLONDE:
			return 0.68
		Look.LADY_LUCK:
			return 0.85
	return 1.0


## How close a skirt panel may come to the leg it hangs over (the rig's panel_leg_clearance, metres at design scale):
## negative for the gowns, whose sheets already stand well off the leg, so they hang still and the legs swing under them
## instead of pushing the hem out behind her like a cape.
static func panel_clearance(look: Look) -> float:
	match look:
		Look.LADY_IN_RED, Look.ESCORT_BLACK, Look.ESCORT_BLONDE:
			return -0.035
	return 0.03


## A look's triangles (every segment mesh and the panels).
static func triangle_count(look: Look) -> int:
	var p: HumanoidParts = parts(look)
	var n: int = 0
	for segment: StringName in HumanoidParts.SEGMENTS:
		var sides: Array[int] = [-1, 1]
		if segment in [&"pelvis", &"chest", &"neck", &"head"]:
			sides = [0]
		for side: int in sides:
			var mesh: ArrayMesh = p.segment_mesh(segment, side)
			if mesh != null:
				n += int(mesh.get_meta(&"triangles", 0))
	var panels: ArrayMesh = p.panel_mesh()
	if panels != null:
		n += int(panels.get_meta(&"triangles", 0))
	return n


static func look_name(look: Look) -> String:
	return String(Look.keys()[look])


static func _build(look: Look) -> HumanoidParts:
	match look:
		Look.LADY_IN_RED:
			return _woman(look, CRIMSON, CRIMSON_SHADE, DARK_HAIR, true)
		Look.ESCORT_BLACK:
			return _woman(look, BLACK_GOWN, BLACK_GOWN_SHADE, BLACK_HAIR, false)
		Look.ESCORT_BLONDE:
			return _woman(look, CRIMSON, CRIMSON_SHADE, BLONDE_HAIR, false)
		Look.LADY_LUCK:
			return _lady_luck()
		Look.GRIMY:
			return _grimy()
		Look.HIGH_ROLLER:
			return _high_roller()
		Look.DEALER:
			return _dealer()
	return _chairman()


# --- The women in gowns ---------------------------------------------------------------------------------------------

## The gown's skirt: the waist ring its panels hang from, its length and its flare.
