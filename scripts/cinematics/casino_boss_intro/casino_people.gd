				{"chamfer": 0.2, "top_scale": Vector2(0.85, 1.0)})
			_add(list, &"chest", BOX, Vector3(0.02, 0.1, 0.075), Vector3(0.084, 0.215, -0.005), hair,
				{"side": MIRRORED, "chamfer": 0.2})
		Look.ESCORT_BLONDE:
			# A high ponytail: tied at the crown with a gold band, swinging down behind her head to her shoulder blades.
			_add(list, &"head", BOX, Vector3(0.056, 0.05, 0.05), Vector3(0.0, 0.186, 0.074), hair,
				{"rotation_degrees": Vector3(30.0, 0.0, 0.0)})
			_add(list, &"head", BOX, Vector3(0.066, 0.28, 0.05), Vector3(0.0, 0.08, 0.136), hair,
				{"chamfer": 0.3, "top_scale": Vector2(0.55, 0.7), "rotation_degrees": Vector3(-168.0, 0.0, 0.0)})
			_add(list, &"head", BOX, Vector3(0.05, 0.012, 0.05), Vector3(0.0, 0.178, 0.078), GOLD,
				{"rotation_degrees": Vector3(30.0, 0.0, 0.0), "shine": GOLD_SHINE})
			_add(list, &"head", BOX, Vector3(0.012, 0.06, 0.014), Vector3(0.073, 0.09, -0.045), hair,
				{"side": MIRRORED, "rotation_degrees": Vector3(0.0, 0.0, 6.0)})
			_add(list, &"head", BOX, Vector3(0.1, 0.03, 0.016), Vector3(0.016, 0.138, -0.079), hair,
