static func _woman(look: Look, gown: Color, shade: Color, hair: Color, glass: bool) -> HumanoidParts:
	var p := _frame(look, Vector3(0.58, 1.34, 0.5), {"hip": Vector3(0.078, -0.035, 0.0), "thigh": 0.29, "shin": 0.29,
