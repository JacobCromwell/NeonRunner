	_add(list, &"hand", BOX, Vector3(0.055, 0.07, 0.06), Vector3(0.0, -0.04, -0.004), SKIN, {"chamfer": 0.35})


## Work trousers and plain dark shoes.
static func _legs(list: Array[HumanoidPiece]) -> void:
	_add(list, &"thigh", PRISM, Vector3(0.11, 0.28, 0.11), Vector3(0.0, -0.13, 0.0), TROUSERS, {"sides": 8})
	_add(list, &"shin", PRISM, Vector3(0.09, 0.28, 0.09), Vector3(0.0, -0.13, 0.0), TROUSERS, {"sides": 8})
	_add(list, &"foot", BOX, Vector3(0.085, 0.06, 0.17), Vector3(0.0, -0.035, -0.035), SHOES,
		{"chamfer": 0.35, "top_scale": Vector2(0.85, 0.7)})


static func _add(list: Array[HumanoidPiece], segment: StringName, shape: HumanoidPiece.Shape, size: Vector3,
		at: Vector3, color: Color, extra: Dictionary = {}) -> void:
	var piece := HumanoidPiece.new()
	piece.segment = segment
	piece.shape = shape
	piece.size = size
	piece.offset = at
	piece.color = color
	for key: String in extra:
		piece.set(key, extra[key])
	list.append(piece)
