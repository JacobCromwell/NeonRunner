	_add(list, &"upper_arm", PRISM, Vector3(0.074, 0.09, 0.074), Vector3(0.0, -0.16, 0.0), SKIN, {"sides": 8})
	_add(list, &"forearm", PRISM, Vector3(0.066, 0.17, 0.064), Vector3(0.0, -0.085, 0.0), SKIN,
		{"sides": 8, "top_scale": Vector2(1.15, 1.12)})
	_add(list, &"forearm", PRISM, Vector3(0.078, 0.07, 0.076), Vector3(0.0, -0.13, 0.0), BRACER,
		{"sides": 8, "side": HumanoidPiece.Placement.LEFT})
	_add(list, &"forearm", BOX, Vector3(0.04, 0.045, 0.012), Vector3(0.0, -0.13, -0.04), SCREEN,
