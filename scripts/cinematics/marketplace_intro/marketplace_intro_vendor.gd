class_name MarketplaceIntroVendor
extends Node3D
## The stall-keeper in the Marketplace's intro (MarketplaceIntro; the owner's beats, October 16, 2026): a market woman
## behind her stall's counter, on the shared HumanoidRig like the runner and the cyborgs, generated by code and kept
## simple (the owner: "render the citizen down in a simplified format ... cut down on a lot of the details"): plain
## boxes and prisms, one material, one draw call a segment, and a mouth of its own that opens as she talks.
## Her look follows the owner's reference picture (October 16, 2026), simplified: dark hair up in a messy bun with a few
## loose strands, a scavenged eyepiece over her right eye, a patterned scarf at her neck, a short-sleeved olive-grey
## shirt with its sleeves rolled, a worn grey-green apron with a pocket, a tech bracer with a little screen on her left
## wrist. DESIGN-TBD (docs/questions/f2f.md): the colours and proportions chosen. Like every Marketplace citizen she
## never reads as a threat: plain lit colours, nothing glowing (the eyepiece's lens and the bracer's screen are dark
## glass), no hazard's colour, no screen face.
##
## The cinematic poses her on its clock (pose()): standing at ease with her hands on the counter, her head turned to
## whoever she looks at; talking (her mouth working, her head bobbing), waving her arms about as she does; pointing.
## Rig convention (HumanoidPiece): metres at design scale, +y up, -z forward (where she faces), +x her right.

const CACHE_KEY: String = "marketplace_intro_vendor_v2"
## Her height as modelled (feet to the top of her bun): fitted to MarketplaceIntroTuning.vendor_height.
const DESIGN_HEIGHT: float = 1.3

const SKIN := Color(0.6, 0.42, 0.3)
const SKIN_SHADE := Color(0.49, 0.33, 0.23)
const HAIR := Color(0.1, 0.08, 0.07)
const SHIRT := Color(0.44, 0.43, 0.35)
const SHIRT_SHADE := Color(0.36, 0.35, 0.28)
const APRON := Color(0.35, 0.37, 0.31)
const APRON_SHADE := Color(0.28, 0.3, 0.25)
const TROUSERS := Color(0.27, 0.23, 0.19)
const SHOES := Color(0.16, 0.12, 0.1)
## The scarf's stripes: a faded rust, a teal and a cream (a muted pattern, never a hazard's red).
const SCARF_A := Color(0.55, 0.33, 0.26)
const SCARF_B := Color(0.2, 0.44, 0.44)
const SCARF_C := Color(0.8, 0.74, 0.6)
## The eyepiece: its brass housing and its lens (dark glass, never glowing); the bracer and its dark screen.
const BRASS := Color(0.6, 0.5, 0.3)
const LENS := Color(0.17, 0.2, 0.22)
const BRACER := Color(0.22, 0.22, 0.23)
const SCREEN := Color(0.2, 0.27, 0.24)
const EYES := Color(0.06, 0.05, 0.05)
const MOUTH := Color(0.24, 0.1, 0.09)

const BOX := HumanoidPiece.Shape.BOX
const PRISM := HumanoidPiece.Shape.PRISM
const MIRRORED := HumanoidPiece.Placement.MIRRORED

## Her mouth (the head joint's space, design metres): its middle, its size shut, and how far it opens.
const MOUTH_AT := Vector3(0.0, 0.032, -0.079)
const MOUTH_SIZE := Vector3(0.036, 0.008, 0.006)
const MOUTH_OPEN: float = 2.6
## Talking: the syllables' rate (Hz; the mouth opening and shutting) and her head's bob (radians, its rate in Hz).
const SYLLABLES_HZ: float = 5.2
const BOB: float = 0.07
const BOB_HZ: float = 2.4
## Waving her arms as she talks: how fast (Hz), and the swing of the upper arm and forearm (degrees).
const WAVE_HZ: float = 1.6
const WAVE_UPPER: float = 28.0
const WAVE_FORE: float = 32.0
## How quickly her head turns to whoever she looks at (1/s; eased), and how its turn is shared out up her spine.
const LOOK_RATE: float = 7.0
const LOOK_SHARE: Array[float] = [0.25, 0.3, 0.45]
const LOOK_JOINTS: Array[StringName] = [&"chest", &"neck", &"head"]
const LOOK_LIMIT: float = 1.6

static var _parts: HumanoidParts

var rig: HumanoidRig
var mouth: MeshInstance3D
## Her head's turn and tip now (radians, + left / + up), easing toward what she looks at.
var look := Vector2.ZERO
var _look_set: bool = false


## Builds her `height` metres tall, facing -z (the cinematic turns her to the street).
func setup(height: float) -> void:
	name = "Vendor"
	rig = HumanoidRig.new()
	rig.name = "Rig"
	add_child(rig)
	var anim := load(PlayerAvatar.ANIM_TUNING_PATH) as HumanoidAnimTuning
	rig.build(parts(), CitizenRig.material(), anim if anim != null else HumanoidAnimTuning.new())
	rig.scale = Vector3.ONE * (height / DESIGN_HEIGHT)
	var batch := MeshBatch.new()
	batch.layer(MeshKit.solid()).box(Vector3.ZERO, MOUTH_SIZE, MOUTH)
	mouth = MeshBatch.add_instance(rig.joint(&"head"), batch.to_mesh(), "Mouth", MOUTH_AT)
	for mi: Node in rig.find_children("*", "MeshInstance3D", true, false):
		(mi as MeshInstance3D).cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	pose(0.0, 0.0, Vector3.ZERO, false, 0.0, 0.0, 0.0, Vector3.ZERO)


## Poses her at `t` (the cinematic's clock; `delta` the step): her head turned toward `look_at` (world space; `looking`
## false: ahead), `talk` (0-1) her mouth working and her head bobbing, `wave` (0-1) her arms waving about, `point`
## (0-1) her arm on that side pointing at `point_at` (world space). Her hands rest on the counter otherwise.
func pose(t: float, delta: float, look_at: Vector3, looking: bool, talk: float, wave: float, point: float,
		point_at: Vector3) -> void:
	rig.animate({"speed": 0.0}, delta)
	# At ease: leaning a little on the counter, her hands on it.
	var rest: float = 1.0 - maxf(wave, 0.0)
	for side: int in [1, -1]:
		_arm(side, Vector3(36.0, 0.0, 9.0), Vector3(38.0, 0.0, 0.0), rest)
	# Waving her arms about as she talks: both up and out, swinging out of step with each other.
	if wave > 0.0:
		for side: int in [1, -1]:
			var s: float = sin(TAU * WAVE_HZ * t + (0.0 if side > 0 else PI * 0.8))
			var c: float = sin(TAU * WAVE_HZ * t + 1.1 + (0.0 if side > 0 else PI * 0.8))
			_arm(side, Vector3(62.0 + WAVE_UPPER * s, 0.0, 38.0 + 14.0 * s), Vector3(70.0 + WAVE_FORE * c, 0.0, 0.0), wave)
	if point > 0.0:
		# With the arm on that side of her.
		var side: StringName = &"r" if (global_transform.affine_inverse() * point_at).x > 0.0 else &"l"
		GanglandOutro.aim_arm(rig, side, point_at, point)
	_turn_head(look_at, looking, delta)
	# Talking: her mouth opening and shutting with the syllables, her head bobbing along.
	var open: float = 0.0
	if talk > 0.0:
		var syllable: float = absf(sin(PI * SYLLABLES_HZ * t)) * (0.55 + 0.45 * sin(TAU * 0.9 * t + 1.3))
		open = talk * clampf(syllable, 0.0, 1.0)
		var head: Node3D = rig.joint(&"head")
		head.rotate_object_local(Vector3.RIGHT, BOB * talk * sin(TAU * BOB_HZ * t))
	mouth.scale = Vector3(1.0, 1.0 + MOUTH_OPEN * open, 1.0)


## How open her mouth is now (0 shut).
func mouth_open() -> float:
	return (mouth.scale.y - 1.0) / MOUTH_OPEN


## Her head's world position (where a camera or a card looks at her).
func head_point() -> Vector3:
	return rig.joint(&"head").global_position


func _turn_head(target: Vector3, looking: bool, delta: float) -> void:
	var want := Vector2.ZERO
	if looking:
		var head: Node3D = rig.joint(&"head")
		var local: Vector3 = global_transform.affine_inverse() * target
		var from: Vector3 = global_transform.affine_inverse() * head.global_position
		var d: Vector3 = local - from
		want.x = clampf(atan2(-d.x, -d.z), -LOOK_LIMIT, LOOK_LIMIT)
		want.y = clampf(atan2(d.y, Vector2(d.x, d.z).length()), -0.6, 0.6)
	if not _look_set:
		look = want
		_look_set = true
	else:
		look = look.lerp(want, 1.0 - exp(-LOOK_RATE * delta))
	for i: int in LOOK_JOINTS.size():
		var j: Node3D = rig.joint(LOOK_JOINTS[i])
		j.rotate_object_local(Vector3.UP, look.x * LOOK_SHARE[i])
		j.rotate_object_local(Vector3.RIGHT, look.y * LOOK_SHARE[i])


## Poses one arm (`side` 1 her right, -1 her left) in degrees (+x forward and up, +z out to the side), blended over the
## rig's pose by `k`.
func _arm(side: int, upper: Vector3, fore: Vector3, k: float) -> void:
	if k <= 0.0:
		return
	var pre: String = "_l" if side < 0 else "_r"
	BeachOutroBar._blend(rig.joint(StringName("upper_arm" + pre)), VolleyballRival._limb(side, upper), k)
	BeachOutroBar._blend(rig.joint(StringName("forearm" + pre)), VolleyballRival._limb(side, fore), k)


## Her parts (built once; every vendor shares them).
static func parts() -> HumanoidParts:
	if _parts == null:
		var p := HumanoidParts.new()
		p.cache_key = CACHE_KEY
		p.design_size = Vector3(0.62, DESIGN_HEIGHT, 0.54)
		# Shorter in the leg and a little broader than the runner's frame.
		p.shoulder_offset = Vector3(0.16, 0.24, 0.0)
		p.thigh_length = 0.28
		p.shin_length = 0.28
		var list: Array[HumanoidPiece] = []
		_body(list)
		_head(list)
		_arms(list)
		_legs(list)
		p.pieces = list
		_parts = p
	return _parts


## An olive-grey shirt, a worn grey-green apron with its bib, its pocket and its straps, a patterned scarf at her neck,
## work trousers.
static func _body(list: Array[HumanoidPiece]) -> void:
	_add(list, &"chest", BOX, Vector3(0.28, 0.3, 0.19), Vector3(0.0, 0.14, 0.0), SHIRT,
		{"chamfer": 0.35, "top_scale": Vector2(0.94, 0.9)})
	_add(list, &"chest", BOX, Vector3(0.24, 0.09, 0.06), Vector3(0.0, 0.17, -0.085), SHIRT, {"chamfer": 0.45})
	_add(list, &"chest", BOX, Vector3(0.19, 0.2, 0.012), Vector3(0.0, 0.1, -0.104), APRON)
	_add(list, &"chest", BOX, Vector3(0.07, 0.05, 0.008), Vector3(0.02, 0.08, -0.112), APRON_SHADE)
	_add(list, &"chest", BOX, Vector3(0.016, 0.12, 0.01), Vector3(0.085, 0.24, -0.094), APRON_SHADE,
		{"side": MIRRORED, "rotation_degrees": Vector3(0.0, 0.0, -12.0)})
	# The scarf: a thick wrap round the neck in three stripes, its end hanging down her front.
	_add(list, &"chest", BOX, Vector3(0.2, 0.05, 0.17), Vector3(0.0, 0.29, -0.005), SCARF_A, {"chamfer": 0.45})
	_add(list, &"chest", BOX, Vector3(0.18, 0.025, 0.155), Vector3(0.0, 0.325, -0.005), SCARF_B, {"chamfer": 0.45})
	_add(list, &"chest", BOX, Vector3(0.21, 0.02, 0.175), Vector3(0.0, 0.268, -0.005), SCARF_C, {"chamfer": 0.45})
	_add(list, &"chest", BOX, Vector3(0.05, 0.12, 0.02), Vector3(-0.045, 0.21, -0.1), SCARF_A,
		{"rotation_degrees": Vector3(0.0, 0.0, 8.0)})
	_add(list, &"chest", BOX, Vector3(0.05, 0.02, 0.022), Vector3(-0.047, 0.2, -0.101), SCARF_B,
		{"rotation_degrees": Vector3(0.0, 0.0, 8.0)})
	_add(list, &"pelvis", BOX, Vector3(0.27, 0.17, 0.19), Vector3(0.0, -0.02, 0.0), TROUSERS, {"chamfer": 0.3})
	_add(list, &"pelvis", BOX, Vector3(0.26, 0.42, 0.012), Vector3(0.0, -0.2, -0.112), APRON,
		{"rotation_degrees": Vector3(-6.0, 0.0, 0.0)})
	_add(list, &"pelvis", BOX, Vector3(0.12, 0.08, 0.008), Vector3(0.0, -0.1, -0.12), APRON_SHADE,
		{"rotation_degrees": Vector3(-6.0, 0.0, 0.0)})
	_add(list, &"pelvis", BOX, Vector3(0.28, 0.02, 0.2), Vector3(0.0, 0.06, 0.0), APRON_SHADE)


## A round face with dark eyes and brows (the mouth is its own mesh), the eyepiece over her right eye, dark hair up in
## a messy bun with a few loose strands.
static func _head(list: Array[HumanoidPiece]) -> void:
	_add(list, &"neck", PRISM, Vector3(0.07, 0.07, 0.07), Vector3(0.0, 0.02, 0.0), SKIN, {"sides": 8})
	_add(list, &"head", BOX, Vector3(0.155, 0.17, 0.155), Vector3(0.0, 0.075, 0.0), SKIN,
		{"chamfer": 0.4, "top_scale": Vector2(0.92, 0.94)})
	_add(list, &"head", BOX, Vector3(0.024, 0.034, 0.02), Vector3(0.0, 0.065, -0.084), SKIN_SHADE,
		{"top_scale": Vector2(0.7, 0.5)})
	# Her left eye (the right one is under the eyepiece) and both brows.
	_add(list, &"head", BOX, Vector3(0.024, 0.016, 0.006), Vector3(-0.036, 0.092, -0.078), EYES)
	_add(list, &"head", BOX, Vector3(0.034, 0.008, 0.006), Vector3(0.036, 0.112, -0.078), HAIR,
		{"side": MIRRORED, "rotation_degrees": Vector3(0.0, 0.0, -8.0)})
	# The eyepiece: a round brass housing with its dark lens, on a band round her head.
	_add(list, &"head", PRISM, Vector3(0.05, 0.03, 0.05), Vector3(0.036, 0.09, -0.086), BRASS,
		{"sides": 8, "rotation_degrees": Vector3(90.0, 0.0, 0.0)})
	_add(list, &"head", PRISM, Vector3(0.036, 0.006, 0.036), Vector3(0.036, 0.09, -0.102), LENS,
		{"sides": 8, "rotation_degrees": Vector3(90.0, 0.0, 0.0), "shine": 0.6})
	_add(list, &"head", BOX, Vector3(0.162, 0.014, 0.162), Vector3(0.0, 0.1, 0.002), BRACER, {"chamfer": 0.4})
	_add(list, &"head", BOX, Vector3(0.022, 0.03, 0.03), Vector3(0.082, 0.095, -0.04), BRASS)
	# The hair: a cap swept up, longer at the back, the bun on top, loose strands at her temples.
	_add(list, &"head", BOX, Vector3(0.165, 0.07, 0.165), Vector3(0.0, 0.145, 0.006), HAIR, {"chamfer": 0.4})
	_add(list, &"head", BOX, Vector3(0.158, 0.1, 0.04), Vector3(0.0, 0.1, 0.066), HAIR, {"chamfer": 0.3})
	_add(list, &"head", BOX, Vector3(0.09, 0.08, 0.08), Vector3(0.0, 0.205, 0.03), HAIR,
		{"chamfer": 0.45, "rotation_degrees": Vector3(15.0, 0.0, 10.0)})
	_add(list, &"head", BOX, Vector3(0.012, 0.07, 0.014), Vector3(0.074, 0.085, -0.05), HAIR,
		{"side": MIRRORED, "rotation_degrees": Vector3(0.0, 0.0, 6.0)})
	_add(list, &"head", BOX, Vector3(0.05, 0.012, 0.012), Vector3(-0.02, 0.15, -0.084), HAIR,
		{"rotation_degrees": Vector3(0.0, 0.0, -25.0)})


## Short sleeves rolled up, bare forearms and hands, the bracer with its little screen on her left wrist.
static func _arms(list: Array[HumanoidPiece]) -> void:
	_add(list, &"upper_arm", PRISM, Vector3(0.088, 0.12, 0.088), Vector3(0.0, -0.055, 0.0), SHIRT,
		{"sides": 8, "top_scale": Vector2(1.1, 1.1)})
