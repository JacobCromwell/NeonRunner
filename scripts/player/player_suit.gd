## DESIGN-TBD: weapon look per tier (GDD §8 weapon line; brief: it unfolds from the gold arm's
## shoulder and grows by tier). Placeholder: a gunmetal emitter on a folding mount over the left
## shoulder, a light on its back showing the tier from behind: a laser (cyan, 1), a heavier laser with
## a cooling fin (violet, 2), a missile pod (3) and a heavy four-tube pod (white, 4).
static func _weapon(tier: int) -> Array[HumanoidPiece]:
	var list: Array[HumanoidPiece] = []
	var glow_color: Color = [LASER_1, LASER_1, LASER_2, MISSILE, MISSILE][tier]
	var body: Vector3 = [Vector3.ZERO, Vector3(0.05, 0.05, 0.15), Vector3(0.062, 0.058, 0.17),
		Vector3(0.09, 0.07, 0.15), Vector3(0.12, 0.09, 0.19)][tier]
	var at := Vector3(0.2, 0.33 + body.y * 0.5, -0.01)
	# The folding mount: a pivot on the shoulder and the arm that lifts the weapon.
	_add(list, &"chest", BOX, Vector3(0.036, 0.028, 0.036), Vector3(0.19, 0.285, 0.02), GUNMETAL, 0.0, {"side": LEFT})
	_add(list, &"chest", BOX, Vector3(0.022, at.y - 0.29, 0.03), Vector3(0.195, (at.y + 0.29) * 0.5, 0.03), GUNMETAL, 0.0,
		{"side": LEFT, "rotation_degrees": Vector3(-12.0, 0.0, 0.0)})
	_add(list, &"chest", BOX, body, at, GUNMETAL, 0.0, {"side": LEFT})
	_add(list, &"chest", BOX, Vector3(body.x * 0.6, body.y * 0.4, 0.008), at + Vector3(0.0, 0.0, body.z * 0.5 + 0.004),
		glow_color, 1.2, {"side": LEFT})
	var front: float = at.z - body.z * 0.5
	if tier <= 2:
		var r: float = 0.03 if tier == 1 else 0.038
		_add(list, &"chest", PRISM, Vector3(r, 0.07, r), Vector3(at.x, at.y, front - 0.035), GUNMETAL, 0.0,
			{"side": LEFT, "rotation_degrees": Vector3(90.0, 0.0, 0.0)})
		_add(list, &"chest", BOX, Vector3(r * 0.75, r * 0.75, 0.01), Vector3(at.x, at.y, front - 0.074), glow_color, 1.6,
			{"side": LEFT})
		if tier == 2:
			_add(list, &"chest", BOX, Vector3(0.008, 0.03, 0.1), at + Vector3(0.0, body.y * 0.5 + 0.015, 0.01), GUNMETAL, 0.0,
				{"side": LEFT})
		return list
	var cols: Array[float] = [at.x - body.x * 0.25, at.x + body.x * 0.25]
	var rows: Array[float] = [at.y]
	if tier >= 4:
		rows = [at.y - body.y * 0.22, at.y + body.y * 0.22]
		_add(list, &"chest", BOX, Vector3(0.012, 0.04, 0.12), at + Vector3(0.0, body.y * 0.5 + 0.02, 0.02), GUNMETAL, 0.0,
			{"side": LEFT})
	for x: float in cols:
		for y: float in rows:
			_add(list, &"chest", BOX, Vector3(0.026, 0.026, 0.01), Vector3(x, y, front - 0.004), glow_color, 1.5,
				{"side": LEFT})
	return list


