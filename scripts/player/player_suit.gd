## The trench coat's skirt, knee to mid-calf: four stiff panels hinged under the belt (two behind the
## legs, split by the back vent, and two at the front edges of the open coat), each following the
## thigh on its side. The back ones carry a copper conduit loop and a weathered hem.
static func _skirt() -> Array[HumanoidPanel]:
	var out: Array[HumanoidPanel] = []
	for side: int in [1, -1]:
		out.append(_skirt_panel(side, true))
		out.append(_skirt_panel(side, false))
	return out


static func _skirt_panel(side: int, behind: bool) -> HumanoidPanel:
	var panel := HumanoidPanel.new()
	panel.side = side
	panel.behind = behind
	panel.length = SKIRT_LENGTH
	# The hinge sits halfway through the panel's depth, so its top edge stays under the belt.
	panel.hinge = Vector3(0.1, SKIRT_HINGE_Y, 0.064) if behind else Vector3(0.13, SKIRT_HINGE_Y, -0.046)
	panel.follow = 0.5 if behind else 0.6
	var pieces: Array[HumanoidPiece] = []
	var at := Vector3(0.0, SKIRT_HINGE_Y, 0.005)
	var arc := Vector2(91.0, 179.0) if behind else Vector2(31.0, 89.0)
	var hem: float = -SKIRT_LENGTH
	# The panel: a flared sheet of the 12-sided waist ring (corners at every 30°).
	pieces.append(_piece(&"pelvis", SHELL, Vector3(SKIRT_HALF.x * 2.0, 0.0, SKIRT_HALF.y * 2.0), at, COAT, 0.0,
		{"sides": 12, "section_phase": 15.0, "arc": arc, "thickness": 0.012,
			"profile": PackedVector4Array([Vector4(0.03, 1.0, 1.0, 0.0), Vector4(hem, SKIRT_FLARE, SKIRT_FLARE, 0.012)])}))
	# A weathered, dusty band along the hem, just outside the sheet.
	var k: float = (SKIRT_LENGTH - 0.07) / SKIRT_LENGTH
	var mid: float = 1.0 + (SKIRT_FLARE - 1.0) * k
	pieces.append(_piece(&"pelvis", BAND, Vector3(SKIRT_HALF.x * 2.0, 0.0, SKIRT_HALF.y * 2.0), at, COAT_WORN, 0.0,
		{"sides": 12, "section_phase": 15.0, "arc": arc, "profile": PackedVector4Array([
			Vector4(hem + 0.002, SKIRT_FLARE + 0.012, SKIRT_FLARE + 0.012, 0.012),
			Vector4(-SKIRT_LENGTH * k, mid + 0.012, mid + 0.012, 0.012 * k)])}))
	if behind:
		# A copper loop down the back of the skirt: down near the vent, across, and back up.
		var p1: Vector3 = _skirt_point(160.0, -0.02)
		var p2: Vector3 = _skirt_point(160.0, -0.3)
		var p3: Vector3 = _skirt_point(118.0, -0.3)
		var p4: Vector3 = _skirt_point(118.0, -0.06)
		for seg: Array in [[p1, p2], [p2, p3], [p3, p4]]:
			var out_dir := Vector3((seg[0] as Vector3).x, 0.0, (seg[0] as Vector3).z - 0.005)
			pieces.append(_pipe_piece(&"pelvis", seg[0], seg[1], 0.022, out_dir.normalized(), GLOW, CONDUIT_GLOW))
	panel.pieces = pieces
	return panel


## A point on the skirt's outside (pelvis joint space) at `angle` degrees round the waist (0 = front,
## 90 = the right side, 180 = back) and `height` below the hinge line.
static func _skirt_point(angle: float, height: float) -> Vector3:
	var t: float = clampf(-height / SKIRT_LENGTH, 0.0, 1.0)
	var scale: float = 1.0 + (SKIRT_FLARE - 1.0) * t
	var a: float = deg_to_rad(angle)
	var r := Vector2(SKIRT_HALF.x * scale + 0.008, SKIRT_HALF.y * scale + 0.008)
	return Vector3(sin(a) * r.x, SKIRT_HINGE_Y + height, -cos(a) * r.y + 0.005 + 0.012 * t)


